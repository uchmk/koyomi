#!/usr/bin/env bash
# Store one secret as a systemd credential file. The value comes from stdin,
# never from an argument (arguments show up in `ps` and shell history).
set -euo pipefail

dir=/etc/koyomi/credentials

usage() {
  cat <<'USAGE'
使い方: sudo koyomi-secret <名前>

  値は標準入力から読み込みます (端末では入力が画面に表示されません。パイプでは全部読み込みます)。
  値を引数で渡すことはできません。
  名前は英数字で始め、英数字と . _ - だけを使用できます。
  /etc/koyomi/credentials/<名前> に、root だけが読み込める形で書き込みます。
  koyomi が起動していれば再起動します。

  例:  printf '%s' "$VALUE" | sudo koyomi-secret db-password
USAGE
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

if [ "$#" -ne 1 ]; then
  usage >&2
  exit 2
fi
name=$1

if [ "$(id -u)" -ne 0 ]; then
  echo "root で実行してください (sudo koyomi-secret <名前>)。" >&2
  exit 1
fi

if ! [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "名前が使えません: 英数字で始め、英数字と . _ - だけを使用してください。" >&2
  exit 2
fi

if [ -t 0 ]; then
  IFS= read -rs -p "${name} の値: " value || true
  echo >&2
else
  # The command substitution drops trailing newlines on purpose: one left by
  # `echo` or a text file would make the stored token never match.
  value=$(cat)
fi
if [ -z "$value" ]; then
  echo "値が空です。何も書き込みませんでした。値を指定してください。" >&2
  exit 1
fi

umask 077
install -d -m 0700 -o root -g root /etc/koyomi "$dir"
tmp=$(mktemp "$dir/.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT
printf '%s' "$value" > "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$dir/$name"
trap - EXIT
echo "書き込みました: $dir/$name"

if systemctl is-active --quiet koyomi 2>/dev/null; then
  echo "koyomi を再起動します。実行中のジョブは停止します。"
  systemctl restart koyomi
  echo "再起動しました。"
else
  echo "koyomi は起動していません。次の起動から使われます。"
fi
